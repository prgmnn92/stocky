# Production Environment Configuration

# Application
APP_ENV=prod
TZ=Europe/Berlin

# Database
DATABASE_URL=sqlite:///data/trader.db

# Market Data Provider
DATA_PROVIDER=yahoo
LOOKBACK_DAYS=400

# Scheduler (Market close times - adjust for your timezone)
SCHED_HOUR=20
SCHED_MINUTE=0
SCHED_TIMEZONE=Europe/Berlin

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Authentication (REQUIRED - generate a secure key)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-jwt-secret-key-here-change-this

# AI Features (Optional - required for sentiment analysis and chat)
OPENAI_API_KEY=your-openai-api-key-here
